rules_version = '2';
// Tarayıcıdan doğrudan erişim tamamen kapalıdır.
// Tüm okuma ve yazmalar Vercel'deki sunucu kodu tarafından Firebase Admin SDK ile yapılır.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
